    "scripts/main.js"
  ],
  "styles": [
    "styles/wfrp4-personnal-rules.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "languages/en.json"
    },
    {
      "lang": "fr",
