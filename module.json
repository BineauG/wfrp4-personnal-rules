        "compatibility": {
          "minimum": "1.0.1",
          "verified": "1.0.1"
        }
      },
      {
        "id": "socketlib",
        "type": "module",
        "compatibility": {}
      }
    ]
  },
  "socket": true,
  "url": "https://github.com/BineauG/wfrp4-personnal-rules",
  "manifest": "https://raw.githubusercontent.com/BineauG/wfrp4-personnal-rules/main/module.json",
  "download": "https://github.com/BineauG/wfrp4-personnal-rules/archive/refs/heads/main.zip"
