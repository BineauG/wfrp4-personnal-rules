{
  "id": "wfrp4-personnal-rules",
  "title": "wfrp4-personnal-rules",
  "version": "1.0.0",
  "description": "Personal WFRP4E rules for Item Piles merchants, availability, locked doors, and custom difficulties.",
  "authors": [
    {
      "name": "Guillaume Bineau"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "13"
  },
